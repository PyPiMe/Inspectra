# NAME: Keepalived 概览
# MODE: instant
# UNIT: mixed
# DISPLAY: true
# Info-only: keepalived up / VRRP state / script status
label_replace(keepalived_up{$instance}, "item", "keepalived_up", "job", ".*")
or label_replace(keepalived_vrrp_state{$instance}, "item", "keepalived_vrrp", "iname", ".*")
or label_replace(keepalived_script_status{$instance}, "item", "keepalived_health", "name", ".*")
