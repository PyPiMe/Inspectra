# NAME: Nginx 概览
# MODE: instant
# UNIT: mixed
# DISPLAY: true
# Info-only: nginx overview panel
label_replace(nginx_up{$instance}, "item", "nginx_up", "__name__", ".*")
or label_replace(nginx_connections_active{$instance}, "item", "nginx_active", "__name__", ".*")
or label_replace(nginx_connections_reading{$instance}, "item", "nginx_reading", "__name__", ".*")
or label_replace(nginx_connections_writing{$instance}, "item", "nginx_writing", "__name__", ".*")
or label_replace(nginx_connections_waiting{$instance}, "item", "nginx_waiting", "__name__", ".*")
or label_replace(nginx_connections_accepted{$instance}, "item", "nginx_accepted", "__name__", ".*")
or label_replace(nginx_connections_handled{$instance}, "item", "nginx_handled", "__name__", ".*")
or label_replace(nginx_http_requests_total{$instance}, "item", "nginx_requests", "__name__", ".*")
