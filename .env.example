# PyPiMeOps Docker 环境变量模板：复制为 .env 后按需修改。
# Docker env template: copy to .env and adjust.

# 数据文件属主（容器内以该 UID/GID 运行；建议设为宿主 ./data 所有者）
# Owner of ./data (container runs as this UID/GID; set to the host ./data owner).
PUID=1000
PGID=1000

# 时区：留空 = UTC；按部署地填写，如 Asia/Shanghai。
# Timezone: empty = UTC; set to the deployment zone, e.g. Asia/Shanghai.
TZ=
