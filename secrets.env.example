# Inspectra 敏感配置模板（复制为 secrets.env，chmod 600，且不要提交到 git）
# 格式：KEY=VALUE，每行一个，支持 # 注释

# --- 模型供应商 API key（按实际使用的供应商填写）---
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
OLLAMA_API_KEY=

# --- 通知 ---
SMTP_PASSWORD=
DINGTALK_SECRET=

# --- Prometheus 数据源凭据（basic=user:pass，bearer=token）---
# 变量名需与数据源配置中的 secret_env 一致
PROM_TOKEN=
PROM_BASIC=

# --- 环境参数示例 ---
# MODEL_API_KEY_ENV 指向的变量（如 DEEPSEEK_API_KEY）填入真实 key
# TEST_PROM_AUTH 为 bearer 时，PROM_TOKEN 填真实 token
