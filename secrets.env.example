# Inspectra 敏感配置模板（复制为 secrets.env，chmod 600，且不要提交到 git）
# 格式：KEY=VALUE，每行一个，支持 # 注释

# --- 模型供应商 API key（按实际使用的供应商填写）---
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
OLLAMA_API_KEY=

# --- 通知 ---
SMTP_PASSWORD=
DINGTALK_SECRET=

# --- Prometheus 数据源凭据（basic=user:pass，bearer=token）---
# 变量名需与数据源配置中的 secret_env 一致
PROM_TOKEN=
PROM_BASIC=

# --- 示例说明 ---
# 模型变量名需与模型条目的 api_key_env 一致（见上方列表）
# Prometheus 为 bearer 认证时，PROM_TOKEN 填真实 token
